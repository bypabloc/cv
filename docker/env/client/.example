# Portfolio - Variables de categoria CLIENT.
#
# Valores PUBLICOS: acaban en el bundle del browser via import.meta.env.PUBLIC_*
# o configuran infra local (puertos, dominios). NO contienen secretos.
#
# Copiar a docker/env/client/.{local,dev,test,prod}.
# Los archivos .{env} estan en .gitignore; este .example si se versiona.

# Puerto Nginx publicado al host.
# Defaults: local 9970, dev 9971, test 9972, prod 9973
PROXY_PORT=

# URLs publicas — derivadas en build time:
#   BASE_DOMAIN  -> dominio base (sin esquema, sin puerto, sin subdominio)
#   BASE_SCHEME  -> http | https
#   BASE_PORT    -> puerto a inyectar (vacio = sin puerto explicito)
BASE_DOMAIN=
BASE_SCHEME=
BASE_PORT=

# Flag de CI mode (solo .test). Vacio fuera de CI.
CI=

# Base URL del API Gateway (sin trailing slash). La pagina /contact arma
# el endpoint final como `${PUBLIC_API_ENDPOINT}/contact`.
PUBLIC_API_ENDPOINT=

# Cloudflare Turnstile sitekey publica del widget Portfolio Backend.
# Es publica (no es secreto): se inyecta en el HTML del frontend.
#
# IMPORTANTE: hay UN widget Turnstile POR ENTORNO (dev / prod), cada
# uno con su propio par sitekey + secret. El sitekey que va aqui DEBE emparejar
# con el secret en SSM `/portfolio/{stage}/turnstile-secret` del mismo entorno;
# si no emparejan, `siteverify` devuelve `invalid-input-secret` y el backend
# responde 403 al form de contacto. Mapeo de los widgets "Portfolio Backend":
#   .local  -> reusa el widget de dev   (su allowlist incluye localhost)
#   .dev    -> widget "Portfolio Backend (dev)"
#   .prod   -> widget "Portfolio Backend (prod)"
# El sitekey de cada widget se ve en el dashboard de Cloudflare Turnstile;
# el secret se rota con `serverless setup-ssm` (ver serverless-secrets.md).
# En los deploys de Cloudflare Pages el sitekey vive como env var del proyecto
# Pages (uno por app x entorno), no en estos archivos.
PUBLIC_TURNSTILE_SITEKEY=

# Sitekey publica del widget Turnstile (mismo valor que PUBLIC_TURNSTILE_SITEKEY;
# se mantiene sin prefijo para consumidores server-side que la referencian).
TURNSTILE_SITE_KEY=

# Toggle de validacion Turnstile: `true` (validar) | `false` (skip, solo dev/test).
TURNSTILE_ENABLED=

# --- Admin panel (Next.js SPA) ----------------------------------------
# Next lee process.env.NEXT_PUBLIC_* en build/dev y las inlinea en el
# bundle del browser. Son publicas (no secretos), categoria client.
#
# Equivalencia con las apps Astro:
#   NEXT_PUBLIC_API_ENDPOINT      = mismo valor que PUBLIC_API_ENDPOINT
#   NEXT_PUBLIC_TURNSTILE_SITEKEY = mismo valor que PUBLIC_TURNSTILE_SITEKEY
# URL del admin por entorno (admin.portfolio.dev.the-full-stack.com,
# admin.portfolio.the-full-stack.com en prod, admin.localhost:9970 en local).
NEXT_PUBLIC_API_ENDPOINT=
NEXT_PUBLIC_TURNSTILE_SITEKEY=
NEXT_PUBLIC_ADMIN_URL=
# Lead time (ms) para refrescar el access JWT antes de su exp. Default 30000.
NEXT_PUBLIC_AUTH_REFRESH_LEAD_MS=30000
# Relying Party ID de WebAuthn (hostname del admin por entorno). Un passkey
# NO migra entre entornos (esperado).
NEXT_PUBLIC_WEBAUTHN_RP_ID=
# Toggle de UI de la seccion de seguridad / MFA del admin.
NEXT_PUBLIC_FEATURE_MFA=true
