{
  "name": "@portfolio/markdown-export",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HTML -> Markdown converter for the portfolio dist (postbuild) — sirve .md gemelo de cada index.html para agentes con Accept: text/markdown",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "esbuild": "^0.27.7",
    "node-html-parser": "^7.0.1",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.5",
    "@types/turndown": "^5.0.5",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
