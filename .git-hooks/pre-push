#!/usr/bin/env python3
"""Pre-push hook - portfolio Astro 6 monorepo.

Ejecuta validaciones estrictas vs base branch (origin/main por default):
  1. Conformance: Biome lint + format check sobre todos los archivos modificados
  2. Frontend purity: prohibe .js/.jsx/.mjs/.cjs salvo configs en raíz
  3. Typecheck: tsc --noEmit + astro check
  4. Unit tests + coverage per-file >= 80% (packages modificados)
  5. Build: pnpm run build (todas las apps)
  6. Feature tests (Playwright E2E): levanta stack Docker test + ejecuta specs.
     Solo corre si Docker esta disponible; en CI se omite (Docker desactivado).

Skip por env:
    SKIP_STEPS="build" git push ...
    SKIP_STEPS="feature_tests" git push ...
    SKIP_STEPS="typecheck,build" git push ...

Opt-in:
    RUN_BUILD_TESTS=1 git push ...     # corre Capa B (build-tests del dist)
"""

from __future__ import annotations

from pathlib import Path
import sys


HOOK_DIR = Path(__file__).resolve().parent
sys.path.insert(0, str(HOOK_DIR))

from _common import (  # noqa: E402
    PROJECT_ROOT,
    PORTFOLIO_APPS,
    detect_modified_apps,
    detect_modified_packages,
    err,
    fail,
    filter_lintable_files,
    find_forbidden_js_files,
    get_unmerged_files,
    green,
    header,
    info,
    ok,
    out,
    run_pnpm,
    run_pnpm_exec,
    section,
    should_run_step,
    skip,
    tip,
)


HOOK_NAME = 'pre-push'


def step_conformance(files: list[str], step_label: str) -> int:
    section(f'[PASO {step_label}] Conformance (Biome lint + format)')
    if not files:
        info('Sin archivos para lintear.')
        ok(f'Paso {step_label}: Conformance')
        return 0
    rc = run_pnpm_exec(['biome', 'check', *files], cwd=PROJECT_ROOT)
    if rc != 0:
        return fail(
            f'Paso {step_label}: Conformance - FALLO',
            'PUSH BLOQUEADO',
            HOOK_NAME,
        )
    ok(f'Paso {step_label}: Conformance')
    return 0


def step_purity(files: list[str], step_label: str) -> int:
    section(f'[PASO {step_label}] Frontend Type Purity')
    violations = find_forbidden_js_files(files)
    if not violations:
        ok(f'Paso {step_label}: Frontend Purity')
        return 0
    err(f'{len(violations)} archivo(s) JavaScript prohibido(s):')
    for f in violations:
        out(f'  - {f}')
    return fail(
        f'Paso {step_label}: Frontend Purity - FALLO',
        'PUSH BLOQUEADO',
        HOOK_NAME,
    )


def step_typecheck(modified_apps: list[str],
                   modified_packages: list[str],
                   step_label: str) -> int:
    section(f'[PASO {step_label}] TypeScript Typecheck (tsc + astro check)')

    if not modified_apps and not modified_packages:
        info('Sin apps ni packages modificados.')
        ok(f'Paso {step_label}: Typecheck')
        return 0

    # Astro check por cada app modificada
    for app in modified_apps:
        info(f'astro check en apps/{app}')
        rc = run_pnpm_exec(
            ['astro', 'check'],
            cwd=PROJECT_ROOT / 'apps' / app,
        )
        if rc != 0:
            return fail(
                f'Paso {step_label}: astro check en apps/{app} - FALLO',
                'PUSH BLOQUEADO',
                HOOK_NAME,
            )

    # tsc --noEmit global (cubre packages también)
    info('tsc --noEmit en raíz (recursivo en workspaces)')
    rc = run_pnpm(['run', 'typecheck'], cwd=PROJECT_ROOT)
    if rc != 0:
        return fail(
            f'Paso {step_label}: tsc --noEmit - FALLO',
            'PUSH BLOQUEADO',
            HOOK_NAME,
        )

    ok(f'Paso {step_label}: Typecheck')
    return 0


def _package_has_script(pkg: str, script: str) -> bool:
    """True si packages/<pkg>/package.json define el script dado."""
    import json
    pkg_json = PROJECT_ROOT / 'packages' / pkg / 'package.json'
    if not pkg_json.exists():
        return False
    try:
        data = json.loads(pkg_json.read_text())
    except json.JSONDecodeError:
        return False
    return script in data.get('scripts', {})


def step_unit_tests(modified_packages: list[str], step_label: str) -> int:
    section(f'[PASO {step_label}] Unit Tests + Coverage (>=80%)')

    if not modified_packages:
        info('Sin packages modificados, omitiendo unit tests.')
        ok(f'Paso {step_label}: Unit Tests')
        return 0

    for pkg in modified_packages:
        if not _package_has_script(pkg, 'test:coverage'):
            skip(f'packages/{pkg}: sin script test:coverage, omitido')
            continue
        info(f'vitest run --coverage en packages/{pkg}')
        rc = run_pnpm(
            ['run', 'test:coverage'],
            cwd=PROJECT_ROOT / 'packages' / pkg,
        )
        if rc != 0:
            return fail(
                f'Paso {step_label}: tests packages/{pkg} - FALLO',
                'PUSH BLOQUEADO',
                HOOK_NAME,
            )

    ok(f'Paso {step_label}: Unit Tests + Coverage')
    return 0


def step_build(step_label: str) -> int:
    section(f'[PASO {step_label}] Static Build (pnpm run build)')
    info('Build estático de todas las apps Astro')
    rc = run_pnpm(['run', 'build'], cwd=PROJECT_ROOT, timeout=600)
    if rc != 0:
        return fail(
            f'Paso {step_label}: build - FALLO',
            'PUSH BLOQUEADO',
            HOOK_NAME,
        )
    ok(f'Paso {step_label}: Build')
    return 0


def step_build_tests(step_label: str) -> int:
    """Build-tests del dist (Capa B del plan build-env-vars-per-env).

    Opt-in con RUN_BUILD_TESTS=1 porque son lentos (~15s) y solo importan
    cuando se toca packages/ui/src/components/TrackingPixel.astro,
    packages/ui/src/lib/validate-build-env.ts, o el cableado de env vars
    en el deploy. Verifica que el dist tenga el data-api-endpoint
    correcto y que el build sin env vars FALLA con el guard.
    """
    import os
    section(f'[PASO {step_label}] Build Tests (Capa B: dist regression)')
    if os.environ.get('RUN_BUILD_TESTS', '') != '1':
        skip('RUN_BUILD_TESTS!=1 -> omitido (opt-in)')
        tip('Para correr: RUN_BUILD_TESTS=1 git push ...')
        ok(f'Paso {step_label}: Build Tests')
        return 0
    info('vitest --config vitest.build.config.ts en packages/ui')
    rc = run_pnpm(
        ['run', 'test:build'],
        cwd=PROJECT_ROOT / 'packages' / 'ui',
        timeout=300,
    )
    if rc != 0:
        return fail(
            f'Paso {step_label}: build-tests - FALLO',
            'PUSH BLOQUEADO',
            HOOK_NAME,
        )
    ok(f'Paso {step_label}: Build Tests')
    return 0


def _docker_available() -> bool:
    """True si docker CLI esta instalado y daemon corriendo."""
    import shutil
    import subprocess
    if not shutil.which('docker'):
        return False
    try:
        result = subprocess.run(
            ['docker', 'info'],
            capture_output=True, check=False, timeout=5,
        )
        return result.returncode == 0
    except (subprocess.TimeoutExpired, OSError):
        return False


def _run_devtools(args: list[str], *, timeout: int = 600) -> int:
    """Invoca python devtools/run.py <args>."""
    import os
    import subprocess
    cmd = ['python3', 'devtools/run.py', *args]
    info(f'$ {" ".join(cmd)}')
    env = os.environ.copy()
    env.setdefault('CI', 'true')
    try:
        result = subprocess.run(
            cmd, cwd=str(PROJECT_ROOT), check=False, timeout=timeout, env=env,
        )
        return result.returncode
    except FileNotFoundError:
        err('python3 no esta disponible')
        return 127


def step_feature_tests(step_label: str) -> int:
    """Levanta stack Docker (local) + corre Playwright via test_runner."""
    section(f'[PASO {step_label}] Feature tests (Playwright E2E via Docker)')

    if not _docker_available():
        skip(f'Paso {step_label}: Docker no disponible, omitido')
        tip('Para correr E2E: instalar Docker y reintentar push, o SKIP_STEPS="feature_tests"')
        return 0

    info('Levantando stack Docker local (devtools docker up)...')
    rc = _run_devtools(['docker', 'up', '--env=local'], timeout=300)
    if rc != 0:
        return fail(
            f'Paso {step_label}: docker up fallo',
            'PUSH BLOQUEADO',
            HOOK_NAME,
        )

    info('Ejecutando feature tests (Playwright)...')
    rc = _run_devtools(
        ['test_runner', '--module=feature', '--type=feature', '--env=local'],
        timeout=900,
    )
    if rc != 0:
        return fail(
            f'Paso {step_label}: Feature tests fallaron',
            'PUSH BLOQUEADO',
            HOOK_NAME,
        )

    ok(f'Paso {step_label}: Feature tests')
    return 0


def main() -> int:
    header('PRE-PUSH - Quality Gates (Astro 6 portfolio)')

    all_changes = get_unmerged_files()
    lintable = filter_lintable_files(all_changes)
    modified_apps = detect_modified_apps(all_changes)
    modified_packages = detect_modified_packages(all_changes)

    if not lintable and not modified_apps and not modified_packages:
        info('Sin cambios en apps/* o packages/* vs base branch.')
        out('')
        out('=' * 80)
        out(green('  PUSH permitido (sin cambios en frontend)'))
        out('=' * 80)
        return 0

    info(f'lintables  : {len(lintable)}')
    info(f'apps modif : {modified_apps or "(ninguna)"}')
    info(f'pkgs modif : {modified_packages or "(ninguno)"}')
    out('')

    steps = [
        ('conformance', lambda lbl: step_conformance(lintable, lbl)),
        ('frontend_purity', lambda lbl: step_purity(lintable, lbl)),
        ('typecheck', lambda lbl: step_typecheck(modified_apps, modified_packages, lbl)),
        ('unit_tests', lambda lbl: step_unit_tests(modified_packages, lbl)),
        ('build', lambda lbl: step_build(lbl)),
        ('build_tests', lambda lbl: step_build_tests(lbl)),
        ('feature_tests', lambda lbl: step_feature_tests(lbl)),
    ]

    active = [(name, fn) for name, fn in steps if should_run_step(name, HOOK_NAME)]
    for skipped in [name for name, _ in steps if (name, _) not in active]:
        # Notar — los skipped no se imprimen explicitamente; el config dicta
        pass

    total = len(active)
    for i, (_, fn) in enumerate(active, 1):
        rc = fn(f'{i}/{total}')
        if rc != 0:
            return rc
        out('')

    out('=' * 80)
    out(green('  TODAS LAS QUALITY GATES PASARON - Push permitido'))
    out('=' * 80)
    return 0


if __name__ == '__main__':
    sys.exit(main())
