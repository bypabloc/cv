---
/**
 * @component Footer
 * @description Footer minimalista con copyright + links sociales + boton de
 *   gestion de consentimiento (GDPR: revocar debe ser tan facil como otorgar).
 *
 *   Los textos vienen del YAML i18n (`elements.<lang>.yaml`, rama
 *   `components.footer`). El `copyright` usa los marcadores `{year}` y
 *   `{name}`, que este componente interpola.
 *
 * @props {string} name - Nombre del titular del copyright
 * @props {object} contacts - Links sociales (linkedin, github)
 * @props {object} strings - Textos del footer (components.footer del i18n)
 */
import type { ComponentsStrings } from '@portfolio/content'

interface Props {
  name: string
  contacts: {
    linkedin: string
    github: string
    email?: string
  }
  strings: ComponentsStrings['footer']
}

const { name, contacts, strings } = Astro.props
const year = new Date().getUTCFullYear()
const copy = strings.copyright
  .replace('{year}', String(year))
  .replace('{name}', name)
---

<footer class="site-footer">
  <div class="container-wide site-footer__inner">
    <p class="site-footer__copy">{copy}</p>
    <ul class="site-footer__links">
      <li>
        <a href={contacts.linkedin} rel="me" target="_blank"
          >{strings.linkedin}</a
        >
      </li>
      <li>
        <a href={contacts.github} rel="me" target="_blank">{strings.github}</a>
      </li>
      <li>
        <button
          type="button"
          class="site-footer__consent"
          data-action="reopen-consent"
          data-testid="manage-consent"
        >
          {strings.manageConsent}
        </button>
      </li>
    </ul>
  </div>
</footer>

<script>
  import { REOPEN_BANNER_EVENT } from '../lib/cookie-consent'

  function initManageConsent(): void {
    const buttons = document.querySelectorAll<HTMLButtonElement>(
      '[data-action="reopen-consent"]',
    )
    for (const btn of buttons) {
      if (btn.dataset.cfConsentInit === '1') continue
      btn.dataset.cfConsentInit = '1'
      btn.addEventListener('click', () => {
        // El banner devuelve el foco a este boton al cerrarse.
        document.dispatchEvent(
          new CustomEvent(REOPEN_BANNER_EVENT, { detail: { opener: btn } }),
        )
      })
    }
  }

  initManageConsent()
  document.addEventListener('astro:after-swap', initManageConsent)
</script>

<style>
  /* Mobile-first */
  .site-footer {
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-24);
    margin-top: var(--space-56);
  }
  @media (min-width: 768px) {
    .site-footer {
      padding-block: var(--space-32);
      margin-top: var(--space-80);
    }
  }
  .site-footer__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    flex-wrap: wrap;
  }
  .site-footer__copy {
    color: var(--color-text-muted);
    font-size: var(--font-size-13);
  }
  .site-footer__links {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }
  .site-footer__links a,
  .site-footer__consent {
    font-family: var(--font-mono);
    font-size: var(--font-size-12);
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--letter-spacing-wider);
  }
  .site-footer__links a:hover,
  .site-footer__consent:hover {
    color: var(--color-text);
  }
  /* El boton de consentimiento se ve como un link del footer */
  .site-footer__consent {
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
  }
  .site-footer__consent:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    border-radius: var(--radius-xs);
  }
</style>
