---
import type { Project } from '@portfolio/content'
import CaseStudyExpander from '@portfolio/ui/components/CaseStudyExpander.astro'
import SectionHeader from '@portfolio/ui/components/SectionHeader.astro'
/**
 * @component ProjectDetail
 * @description Vista de detalle completa de un proyecto: nombre, summary,
 *   descripcion, stack, enlaces (url/repo), case study detallado
 *   (problema/proceso/resultado) y metricas. La usan las paginas
 *   /projects/<slug> de cada app. No renderiza el flag interno
 *   metricsEstimated.
 *
 * @props {Project} project - El proyecto a renderizar
 * @props {'es'|'en'} locale - Idioma activo
 * @props {I18nStrings} strings - Strings de UI de la app
 */
import type { I18nStrings } from '../lib/site-config'

interface Props {
  project: Project
  locale: 'es' | 'en'
  strings: I18nStrings
}

const { project: p, locale, strings: t } = Astro.props
const cs = p.caseStudyDetailed
const metricEntries = p.metrics ? Object.entries(p.metrics) : []
const resolvedLinks =
  p.links?.map((l) => ({ label: l.label[locale], url: l.url })) ?? []
---

<article class="container-medium section project-detail">
  <SectionHeader eyebrow="02" title={p.name} />

  <p class="project-detail__summary">{p.summary[locale]}</p>

  {p.description && <p class="text-muted">{p.description[locale]}</p>}

  {
    resolvedLinks.length > 0 ? (
      <ul class="project-detail__link-chips">
        {resolvedLinks.map((l) => (
          <li>
            <a href={l.url} target="_blank" rel="noopener noreferrer" class="project-detail__link-chip">
              {l.label}
              <svg width="12" height="12" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                <path d="M3 11L11 3M11 3H5M11 3V9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
          </li>
        ))}
        {p.repo && (
          <li>
            <a href={p.repo} target="_blank" rel="noopener noreferrer" class="project-detail__link-chip project-detail__link-chip--ghost">
              {t.labels.viewRepo}
            </a>
          </li>
        )}
      </ul>
    ) : (
      <p class="project-detail__links text-mono text-muted">
        {p.url && (
          <a href={p.url} target="_blank" rel="noopener noreferrer">
            {t.labels.viewSite}
          </a>
        )}
        {p.url && p.repo && ' · '}
        {p.repo && (
          <a href={p.repo} target="_blank" rel="noopener noreferrer">
            {t.labels.viewRepo}
          </a>
        )}
      </p>
    )
  }

  {
    p.stack.length > 0 && (
      <>
        <h3 class="text-h5 project-detail__heading">
          {t.sections.skills.title}
        </h3>
        <ul class="project-detail__chips">
          {p.stack.map((s) => (
            <li class="project-detail__chip">{s}</li>
          ))}
        </ul>
      </>
    )
  }

  {
    cs && (
      <div class="project-detail__case-wrapper">
        <h3 class="text-h5 project-detail__heading">
          {t.labels.caseStudyCta}
        </h3>
        <CaseStudyExpander
          title={p.name}
          problem={cs.problem[locale]}
          process={cs.process[locale]}
          result={cs.result[locale]}
          metrics={metricEntries.map(([k, v]) => `${k}: ${v}`)}
          labels={{
            cta: t.labels.caseStudyCta,
            problem: t.labels.caseStudyProblem,
            process: t.labels.caseStudyProcess,
            result: t.labels.caseStudyResult,
            metricsTitle: t.labels.caseStudyMetrics,
          }}
        />
      </div>
    )
  }

  {
    !cs && metricEntries.length > 0 && (
      <>
        <h3 class="text-h5 project-detail__heading">
          {t.labels.caseStudyMetrics}
        </h3>
        <ul class="project-detail__metrics">
          {metricEntries.map(([key, value]) => (
            <li>
              <strong>{key}</strong>: {value}
            </li>
          ))}
        </ul>
      </>
    )
  }

  <p class="project-detail__back">
    <a href="/#projects">&larr; {t.labels.home}</a>
  </p>
</article>

<style>
  .project-detail__summary {
    margin-top: var(--space-8);
    font-size: var(--font-size-16);
  }
  .project-detail__links {
    margin-top: var(--space-8);
    overflow-wrap: break-word;
  }
  .project-detail__link-chips {
    margin-top: var(--space-8);
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }
  .project-detail__link-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-8) var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--niche-accent);
    color: #0a0a0a;
    font-size: var(--font-size-13);
    font-weight: 600;
    text-decoration: none;
    transition: box-shadow var(--motion-base) var(--easing-out);
  }
  .project-detail__link-chip:hover {
    box-shadow: 0 4px 24px var(--niche-glow);
  }
  .project-detail__link-chip--ghost {
    background: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
  }
  .project-detail__link-chip--ghost:hover {
    border-color: var(--niche-accent);
    color: var(--niche-accent);
  }
  .project-detail__heading {
    margin-top: var(--space-24);
    margin-bottom: var(--space-8);
  }
  .project-detail__chips {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }
  .project-detail__chip {
    padding: var(--space-4) var(--space-12);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    font-size: var(--font-size-13);
    color: var(--color-text-muted);
  }
  .project-detail__metrics {
    list-style: disc inside;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }
  .project-detail__back {
    margin-top: var(--space-32);
  }
</style>
