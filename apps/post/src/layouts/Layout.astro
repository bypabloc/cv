---
/**
 * @layout Layout
 * @description Shell de post: head SEO (canonical, hreflang, OG, JSON-LD),
 *   anti-FOUC del tema, header con idioma + toggle y footer.
 *
 * @props {'es' | 'en'} locale - Idioma de la pagina
 * @props {string} title - <title> y og:title
 * @props {string} description - meta description
 * @props {string} slug - '' (home) o el slug de la guia
 * @props {'website' | 'article'} [ogType] - default 'website'
 * @props {object[]} [jsonLd] - bloques JSON-LD
 *
 * @example
 *   <Layout locale="es" title="..." description="..." slug="ntfy" ogType="article" />
 */
import { SITE_URLS } from '@portfolio/app-shared/lib/site-urls'
import type { Locale } from '../lib/guides'
import { AUTHOR, pathFor, UI } from '../lib/i18n'
import '../styles/site.css'

interface Props {
  locale: Locale
  title: string
  description: string
  slug: string
  ogType?: 'website' | 'article'
  jsonLd?: object[]
}

const {
  locale,
  title,
  description,
  slug,
  ogType = 'website',
  jsonLd = [],
} = Astro.props
const t = UI[locale]
const other: Locale = locale === 'es' ? 'en' : 'es'
const site = Astro.site?.href.replace(/\/$/, '') ?? ''
const url = (l: Locale) => `${site}${pathFor(l, slug)}`
const ogImage = `${SITE_URLS.generic}/og-image.svg`
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR} />
    <link rel="canonical" href={url(locale)} />
    <link rel="alternate" hreflang="es" href={url('es')} />
    <link rel="alternate" hreflang="en" href={url('en')} />
    <link rel="alternate" hreflang="x-default" href={url('es')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    <link rel="icon" href={`${SITE_URLS.generic}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={t.siteName} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url(locale)} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {
      jsonLd.map((block) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(block)} />
      ))
    }
    <script is:inline>
      // Tema inicial ANTES de pintar (evita FOUC). Misma clave que el portfolio.
      try {
        const t = localStorage.getItem('theme')
        const root = document.documentElement
        if (t === 'dark') root.classList.add('dark')
        else if (t === 'light') root.classList.add('light')
        root.dataset.theme = t === 'dark' || t === 'light' ? t : 'system'
      } catch (_) {
        document.documentElement.dataset.theme = 'system'
      }
    </script>
  </head>
  <body data-copy={t.copy} data-copied={t.copied}>
    <a class="sr-only" href="#main">{t.skip}</a>
    <header class="site-header">
      <div class="container site-header__inner">
        <a class="brand" href={pathFor(locale)}>the-full-stack<span>/post</span></a>
        <nav class="site-nav" aria-label={t.navLabel}>
          <a class="hide-sm" href={SITE_URLS.generic + (locale === 'en' ? '/en/' : '/')}>{t.portfolio}</a>
          <a href={pathFor(other, slug)} hreflang={other} lang={other}>{t.langLabel}</a>
          <button
            class="icon-btn theme-toggle"
            type="button"
            data-label={t.theme}
            data-names={JSON.stringify(t.themeNames)}
            aria-label={t.theme.replace('{theme}', t.themeNames.system)}
          >
            <svg data-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2" /><path d="M8 20h8M12 16v4" /></svg>
            <svg data-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
            <svg data-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          </button>
        </nav>
      </div>
    </header>
    <main id="main">
      <!-- Cloudflare Email Obfuscation reescribe `ubuntu@203.0.113.10` de los
           bloques de codigo a "[email protected]": se apaga en el contenido. -->
      <Fragment set:html="<!--email_off-->" />
      <slot />
      <Fragment set:html="<!--email_on-->" />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>{t.footer} <a href={SITE_URLS.generic + (locale === 'en' ? '/en/' : '/')} rel="author">{AUTHOR}</a></span>
        <span class="mono">post.the-full-stack.com</span>
      </div>
    </footer>
    <script>
      import '../scripts/client'
    </script>
  </body>
</html>
