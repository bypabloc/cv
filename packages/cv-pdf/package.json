{
  "name": "@portfolio/cv-pdf",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generates CV in HTML and PDF (via Puppeteer if available) from @portfolio/content",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate": "tsx src/generate.ts"
  },
  "dependencies": {
    "@portfolio/content": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
