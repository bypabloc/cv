{
  "name": "@portfolio/app-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared page templates and config helpers for niche Astro apps",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*.astro": "./src/components/*.astro",
    "./layouts/*.astro": "./src/layouts/*.astro",
    "./lib/*": "./src/lib/*.ts",
    "./pages/*.astro": "./src/pages/*.astro"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@portfolio/content": "workspace:*",
    "@portfolio/seo": "workspace:*",
    "@portfolio/ui": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^6.0.0"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^2.1.9",
    "js-yaml": "^4.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^2.1.9"
  }
}
