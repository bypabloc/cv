# Artefacto efimero del deploy: devtools vendoriza shared/ + dependencias
# de runtime aqui antes de armar el zip. Se regenera en cada `serverless
# deploy`; NUNCA se commitea. La fuente de verdad de shared/ vive en
# `serverless/lambda/shared/`.
build/
build.zip

# uv venv aislado del Lambda (creado por `serverless tests`).
.venv/

# Caches locales de python/pytest/coverage.
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.ruff_cache/
.mypy_cache/
