# Temporales
/tmp/
*.tmp
*.log

# Claude Code worktrees efimeros (creados por agentes con isolation: worktree)
.claude/worktrees/

# Harness Engineering: outputs temporales de subagentes
# (current.md, history.md, README.md SI se versionan)
docs/progress/explore_*.md
docs/progress/impl_*.md
docs/progress/review_*.md
docs/progress/optim_*.md
docs/progress/refactor_*.md
docs/progress/audit_*.md
docs/progress/debug_*.md
docs/progress/validate_*.md
docs/progress/.snapshot_*.md
docs/progress/outputs/

# Environment
.env
.env.*
!.env.example

# Docker env files por categoria (gitignored, copy .example).
# Categorias: client (publicas), server (backend + secretos), dev-cli
# (credenciales del CLI). Solo los .example se versionan.
docker/env/*/.local
docker/env/*/.dev
docker/env/*/.stage
docker/env/*/.test
docker/env/*/.prod

# ai_audit (devtools/ai_audit): Playwright storageState personal del dev
# (cookies de Ahrefs/Semrush, categoria dev-cli, LOCAL-ONLY).
docker/env/dev-cli/ai-audit/

# Python (devtools, .git-hooks)
__pycache__/
*.pyc
*.pyo
.venv/
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Tests E2E (artifacts)
tests/results/
tests/**/__pycache__/
tests/.pytest_cache/
# legacy Playwright-TS (se elimina en el refactor e2e; se mantienen los
# ignores mientras la carpeta exista en otras ramas)
tests/feature/report/
tests/feature/results/
tests/feature/blob-report/
tests/feature/test-results/
tests/feature/node_modules/

# Node.js
node_modules/
.pnpm-store/

# Testing / Coverage
coverage/
.nyc_output/

# Astro
.astro/
dist/

# CV HTML generados por scripts/build-public-assets.mjs (prebuild)
# Output puro: cada `astro build` los regenera desde @portfolio/cv-pdf + @portfolio/content
apps/*/public/cv.html
apps/*/public/cv-es.html
apps/*/public/cv-en.html

# CV filters JS bundle copiado por build-public-assets.mjs desde @portfolio/cv-filters
# Output puro: cada build regenera el bundle en packages/cv-filters/dist y copia
apps/*/public/cv-filters.js

# Cloudflare Pages _headers, _redirects y .well-known/api-catalog
# generados por build-public-assets.mjs (prebuild). Output puro: cada
# build regenera con vars del env actual (PUBLIC_API_ENDPOINT,
# BASE_DOMAIN). NO se commitean para evitar drift entre repo y dist.
apps/*/public/_headers
apps/*/public/_redirects
apps/*/public/.well-known/

# Decoders de DRACOLoader/KTX2Loader copiados desde node_modules/three por
# scripts/copy-loader-assets.mjs (prebuild, journey-spiderverse-style).
# Output puro: se regeneran identicos en cada build, no se commitean.
apps/journey/public/draco/
apps/journey/public/basis/

# Playwright
playwright-report/
test-results/
.playwright/

# OS
.DS_Store
Thumbs.db

# act (GitHub Actions local runner)
.secrets

# Claude Code
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/agent-memory/

# VSCode runtime (server-controller)
.vscode/.server-controller-port.log
tmp/

# wrangler local dev state (generated by wrangler pages dev)
.wrangler/

# Lighthouse Chrome temp profiles (WSL: created in CWD as a Windows path)
lighthouse.*
C:\\*
tools/
