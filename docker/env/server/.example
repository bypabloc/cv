# Portfolio - Variables de categoria SERVER.
#
# Config del backend serverless (Lambdas: contact_form, tracking, etc.) y de
# email/DB. Incluye SECRETOS de runtime.
#
# IMPORTANTE: los valores SECRETOS (DB_URL, DB_PASSWORD, TURNSTILE_SECRET_KEY,
# TURNSTILE_BYPASS_SECRET) NO se escriben crudos en estos archivos. Viven en
# AWS SSM Parameter Store (SecureString + KMS). Aqui quedan como placeholder
# vacio — las Lambdas los leen de SSM en runtime. Ver .claude/rules/
# neon-management.md y .claude/rules/security.md.
#
# Copiar a docker/env/server/.{local,dev,stage,test,prod}.
# Los archivos .{env} estan en .gitignore; este .example si se versiona.

# --- Email (SES + sender) -------------------------------------------------
# Backend de email: `ses` (cloud) | `console` (dev, imprime a stdout).
EMAIL_BACKEND=
# Direccion remitente verificada en SES (domain the-full-stack.com).
EMAIL_FROM=
EMAIL_FROM_NAME=
# Destinatario del form de contacto.
OWNER_EMAIL=

# --- AWS region / recursos (NO secretos) ----------------------------------
AWS_REGION=us-east-1
AWS_SES_REGION=us-east-1
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=

# --- AWS SSM Parameter Store (paths que leen las Lambdas) -----------------
SSM_PATH_PREFIX=/portfolio
KMS_KEY_ALIAS=alias/portfolio-lambdas

# --- Database Neon: campos NO sensibles -----------------------------------
DB_DB=neondb
DB_USER=neondb_owner
DB_PORT=5432
DB_SSLMODE=require
# DB_HOST no es secreto pero identifica el branch/proyecto Neon.
DB_HOST=

# --- SECRETOS (placeholder — valor real en SSM SecureString) --------------
# Connection string completa. SSM: /portfolio[/{stage}]/neon-url
DB_URL=
# Password del rol neondb_owner. Embebida en DB_URL.
DB_PASSWORD=
# Secret key del widget Turnstile. SSM: /portfolio[/{stage}]/turnstile-secret
TURNSTILE_SECRET_KEY=
# Token de bypass para Playwright E2E. Generar: openssl rand -hex 32
TURNSTILE_BYPASS_SECRET=
