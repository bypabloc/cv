{
  "name": "@portfolio/app-shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared page templates and config helpers for niche Astro apps",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*.astro": "./src/components/*.astro",
    "./layouts/*.astro": "./src/layouts/*.astro",
    "./lib/*": "./src/lib/*.ts",
    "./pages/*.astro": "./src/pages/*.astro"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@portfolio/content": "workspace:*",
    "@portfolio/seo": "workspace:*",
    "@portfolio/ui": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
