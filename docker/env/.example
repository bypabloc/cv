# Portfolio - Variables de ambiente para Docker Compose + Devtools.
#
# Copiar este archivo a .local, .dev, .test o .prod segun corresponda.
# Los archivos .{env} estan en .gitignore — no committear.
#
# Tabla de ambientes y proposito:
#   .local : desarrollo en la maquina del dev (stack Docker, HMR).
#   .dev   : ambiente de desarrollo en cloud (Cloudflare Pages preview +
#            backend serverless stage=dev en AWS account 637423614564).
#   .test  : ambiente CI / Playwright (stack Docker build + preview,
#            sin credenciales reales).
#   .prod  : produccion (Cloudflare Pages production + backend serverless
#            stage=prod en AWS account 637423614564, region us-east-1).
#
# Las variables se cargan automaticamente por devtools al invocar
# `python devtools/run.py serverless <cmd> --env={local,dev,test,prod}`.

# ===========================================================================
# Infraestructura local (Docker)
# ===========================================================================

# Puerto Nginx (puerto unico publicado al host).
# Defaults por ambiente:
#   local: 9970, dev: 9971, test: 9972, prod: 9973
PROXY_PORT=9970

# UID/GID del usuario host (evita root-owned files en bind mounts).
# Seteados automaticamente por devtools — overridear solo si es necesario.
# UID=1000
# GID=1000

# ===========================================================================
# URLs publicas (build time)
# ===========================================================================

# URLs publicas — derivadas de 3 envs compartidas en build time:
#   BASE_DOMAIN   -> dominio base (sin esquema, sin puerto, sin subdominio)
#   BASE_SCHEME   -> http | https
#   BASE_PORT     -> puerto a inyectar (vacio = sin puerto explicito;
#                    80 con http o 443 con https tambien se omiten)
#
# Cada app construye su URL al hacer build:
#   generic   -> {scheme}://{domain}[:port]
#   hub       -> {scheme}://hub.{domain}[:port]
#   fintech   -> {scheme}://fintech.{domain}[:port]
#   architect -> {scheme}://architect.{domain}[:port]
#   leader    -> {scheme}://leader.{domain}[:port]
#   vibe      -> {scheme}://vibe.{domain}[:port]
#
# Local (todos los subdominios comparten :9970 via nginx en el host):
#   BASE_DOMAIN=localhost BASE_SCHEME=http BASE_PORT=9970
# Prod (sin puerto, https):
#   BASE_DOMAIN=the-full-stack.com BASE_SCHEME=https BASE_PORT=
BASE_DOMAIN=localhost
BASE_SCHEME=http
BASE_PORT=9970

# ===========================================================================
# AWS - credenciales programaticas y region del backend serverless
# ===========================================================================

# Credenciales del IAM user `dev` en account 637423614564 (the-full-stack).
# Usadas por:
#   - devtools/serverless/* para sam deploy, sam build, boto3 local
#   - tests integration que tocan AWS real (moto NO requiere estas keys)
# Las Lambdas en cloud usan IAM Role del SAM template (independiente de
# estas keys).
#
# Rotacion: cuando expiren, regenerar en AWS Console IAM > Users > dev >
# Security credentials > Access keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Region por default para boto3 cuando no se especifica --region.
# Para el portfolio: us-east-1 (donde SES tiene production access GRANTED).
# Las Lambdas + DynamoDB + API Gateway + SES deployan en esta region.
AWS_REGION=us-east-1

# Region especifica para AWS SES.
# us-east-1 - production access GRANTED (50k emails/dia, 14 emails/seg).
# the-full-stack.com domain verificado en esta region.
AWS_SES_REGION=us-east-1

# Bucket S3 para assets estaticos si se necesitan (logos email, etc.).
# Opcional para el portfolio actual.
AWS_STORAGE_BUCKET_NAME=

# ===========================================================================
# Email (SES + sender)
# ===========================================================================

# Backend de email para el frontend stack (Astro).
# Valores: `ses` (cloud, usa SES) | `console` (dev, imprime a stdout).
EMAIL_BACKEND=ses

# Direccion remitente de los emails transaccionales del form de contacto.
# Debe estar verificada en AWS SES como part del domain identity
# `the-full-stack.com` (ya verificado).
EMAIL_FROM=no-reply@the-full-stack.com

# Nombre legible del remitente. Aparece como "FROM_NAME <EMAIL_FROM>".
EMAIL_FROM_NAME=The Full Stack

# Email del owner — destinatario del form de contacto.
# El Lambda contact_form envia notificaciones a esta direccion cuando
# alguien completa el form.
OWNER_EMAIL=pacg1991@gmail.com

# ===========================================================================
# Database (Neon PostgreSQL 18)
# ===========================================================================

# Connection string PostgreSQL para analytics + dashboards.
# Formato: postgresql://USER:PASS@HOST/DB?sslmode=require
# Host: ep-*.c-3.us-east-1.aws.neon.tech (region Neon, no AWS).
# Usuario: neondb_owner (creado por Neon).
# Database: neondb (creada por Neon).
# Pooler: SI (sufijo `-pooler` en host) — requerido para Lambda concurrencia.
#
# Esta variable se carga a SSM Parameter Store como
# /portfolio/neon-url (SecureString + KMS) para que las Lambdas la lean
# en runtime. NO se expone a las Lambdas como env var plana.
DB_URL=

# Campos individuales (opcional, derivable de DB_URL).
# Usados por scripts SQL directos o por psql cli si DB_URL no aplica.
DB_HOST=
DB_PORT=5432
DB_DB=neondb
DB_USER=neondb_owner
DB_PASSWORD=
DB_SSLMODE=require

# ===========================================================================
# Cloudflare Turnstile (anti-bot del form de contacto)
# ===========================================================================

# Sitekey publica del widget Turnstile `Portfolio Backend`.
# Modo: managed. Hostnames: the-full-stack.com + 5 subdominios +
# localhost + 127.0.0.1.
# Esta key se inyecta en el HTML del frontend (es publica, no es secreto).
TURNSTILE_SITE_KEY=

# Secret key del widget Turnstile (privada, server-side only).
# Usada por la Lambda contact_form para validar tokens contra
# https://challenges.cloudflare.com/turnstile/v0/siteverify
#
# Esta variable se carga a SSM Parameter Store como
# /portfolio/turnstile-secret (SecureString + KMS) para que las Lambdas
# la lean en runtime. NO se expone a las Lambdas como env var plana.
TURNSTILE_SECRET_KEY=

# Toggle para habilitar/deshabilitar la validacion Turnstile.
# Valores: `true` (validar siempre) | `false` (skip — solo dev/test).
# En prod debe ser siempre `true`.
TURNSTILE_ENABLED=true

# Token de bypass para tests automatizados (Playwright E2E).
# Si el header `X-Turnstile-Bypass-Secret` matchea este valor, la Lambda
# salta la validacion del token Turnstile. NUNCA usar en prod real
# (rotar el valor cada release si es necesario).
# Generar con: openssl rand -hex 32
TURNSTILE_BYPASS_SECRET=

# ===========================================================================
# Cloudflare API (DNS + Turnstile management + Pages)
# ===========================================================================

# API token con scopes:
#   - All accounts > Cloudflare Pages: Edit (deploy del frontend)
#   - All accounts > Turnstile: Edit (crear/listar widgets)
#   - All zones > SSL and Certificates: Read
#   - All users > User Details: Read
#
# Usado por:
#   - devtools/cloudflare_setup (deploy Pages)
#   - devtools/serverless para verificar widget Turnstile en SPEC-000
#   - SPEC-011 para verificar DNS DKIM de SES
#
# Generar en: Cloudflare Dashboard > My Profile > API Tokens > Create.
CLOUDFLARE_API_TOKEN=

# Account ID de Cloudflare (the-full-stack.com).
# Visible en: Cloudflare Dashboard > seleccionar account > "Account ID" en
# la sidebar derecha.
CLOUDFLARE_ACCOUNT_ID=

# Alias para devtools/cloudflare_setup (script legacy que lee ACCOUNT_ID).
# Mismo valor que CLOUDFLARE_ACCOUNT_ID.
ACCOUNT_ID=

# ===========================================================================
# AWS SSM Parameter Store (paths usados por las Lambdas)
# ===========================================================================
#
# Las Lambdas leen estos parameters en runtime via boto3 SSM API con cache
# Powertools. NO se setean como env vars en el template SAM — solo el
# PATH se referencia.
#
# Inventario:
#   /portfolio/turnstile-secret   — SecureString + KMS (rotable)
#   /portfolio/neon-url           — SecureString + KMS (rotable)
#   /portfolio/owner-email        — String (constante)
#   /portfolio/ses-from-address   — String (constante)
#   /portfolio/dashboard-password-hash — SecureString + KMS (SPEC-014)
#
# Ver serverless/docs/secrets.md para detalle de cada parameter.
SSM_PATH_PREFIX=/portfolio

# KMS key alias para encriptar SSM SecureStrings.
# Custom key (no AWS-managed) para permitir rotacion sin redeploy.
KMS_KEY_ALIAS=alias/portfolio-lambdas

# ===========================================================================
# Solo para .test (CI)
# ===========================================================================

# Flag de CI mode. Si esta seteada, devtools cambia comportamiento:
#   - test_runner asume entorno headless
#   - playwright corre con --reporter=github
#   - sam invoke usa eventos mock predefinidos
CI=

# ===========================================================================
# Frontend env vars publicas (build-time, expuestas al browser)
# ===========================================================================
# Estas se inyectan al build de Astro como `import.meta.env.PUBLIC_*`.
# El frontend ContactForm.astro las lee para configurar el endpoint y
# el Turnstile sitekey.
#
# IMPORTANTE: PUBLIC_TURNSTILE_SITEKEY es la sitekey publica (no es secreta).
# El secret de Turnstile vive en SSM (no aqui).

# Base URL del API Gateway (sin trailing slash).
# La pagina /contact arma el endpoint final como `${PUBLIC_API_ENDPOINT}/contact`.
#
# Custom domains (estandar de subdominios, post-migracion):
#   dev:   https://api.portfolio.dev.the-full-stack.com
#   stage: https://api.portfolio.stage.the-full-stack.com
#   prod:  https://api.portfolio.the-full-stack.com
#
# URLs raw de API Gateway (deprecadas, soft-rollback 30 dias):
#   dev:  https://ssnj6odx7l.execute-api.us-east-1.amazonaws.com/dev
#   prod: https://332ivhahf2.execute-api.us-east-1.amazonaws.com/prod
PUBLIC_API_ENDPOINT=

# Cloudflare Turnstile sitekey publica del widget Portfolio Backend.
# Mismo valor que TURNSTILE_SITE_KEY arriba (se duplica con prefijo PUBLIC_
# porque Astro requiere ese prefijo para exponer al browser).
PUBLIC_TURNSTILE_SITEKEY=
