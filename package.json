{
  "name": "@portfolio/root",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio multi-niche de Pablo Contreras (bypabloc) - Astro 6 monorepo",
  "author": "Pablo Contreras <pacg1991@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.0.9",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "preview": "pnpm -r --parallel run preview",
    "test": "pnpm -r run test",
    "test:unit": "pnpm -r run test:unit",
    "test:e2e": "pnpm -r run test:e2e",
    "test:coverage": "pnpm -r run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r run typecheck",
    "astro:check": "pnpm -r exec astro check",
    "format": "biome format --write .",
    "clean": "pnpm -r exec rm -rf dist .astro node_modules/.vite coverage",
    "prepare": "git config core.hooksPath .git-hooks 2>/dev/null || true",
    "docker:up": "docker compose --project-name portfolio -f docker/docker-compose/local.yml --env-file docker/env/client/.local --env-file docker/env/server/.local --env-file docker/env/dev-cli/.local up -d --build",
    "docker:down": "docker compose --project-name portfolio -f docker/docker-compose/local.yml down",
    "docker:logs": "docker compose --project-name portfolio -f docker/docker-compose/local.yml logs -f",
    "docker:ps": "docker compose --project-name portfolio -f docker/docker-compose/local.yml ps",
    "docker:test:up": "docker compose --project-name portfolio -f docker/docker-compose/test.yml --env-file docker/env/client/.test --env-file docker/env/server/.test --env-file docker/env/dev-cli/.test up -d --build",
    "docker:test:down": "docker compose --project-name portfolio -f docker/docker-compose/test.yml down",
    "e2e": "python devtools/run.py e2e --env=dev --aws-profile=tfs-dev",
    "e2e:app": "python devtools/run.py e2e --module=app --env=dev",
    "e2e:api": "python devtools/run.py e2e --module=api --env=dev --aws-profile=tfs-dev",
    "e2e:admin": "python devtools/run.py e2e --module=admin --env=dev --aws-profile=tfs-dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.1",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "overrides": {
      "vite": "^7"
    },
    "packageExtensions": {
      "@react-three/fiber@8": {
        "peerDependencies": {
          "@types/react": "*"
        }
      },
      "@react-three/drei@9": {
        "peerDependencies": {
          "@types/react": "*"
        }
      }
    }
  }
}
