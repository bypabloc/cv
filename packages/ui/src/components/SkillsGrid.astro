---
/**
 * @component SkillsGrid
 * @description Grid de categorias de skills con chips. Acepta categorias ya
 *   filtradas por nicho.
 */
interface SkillCategoryView {
  slug: string
  title: string
  skills: string[]
}

interface Props {
  categories: SkillCategoryView[]
}

const { categories } = Astro.props
---

<div class="skills-grid">
  {
    categories.map((cat) => (
      <section class="skills-grid__category reveal-on-scroll">
        <h3 class="skills-grid__title text-h6">{cat.title}</h3>
        <ul class="skills-grid__list">
          {cat.skills.map((s) => (
            <li class="skills-grid__chip text-caption">{s}</li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  /* Mobile-first: 1col stack -> auto-fit cards */
  .skills-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
  }
  .skills-grid__category {
    padding: var(--space-16);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  @media (min-width: 640px) {
    .skills-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--space-24);
    }
    .skills-grid__category {
      padding: var(--space-20);
    }
  }
  .skills-grid__title {
    color: var(--color-primary-text);
    margin-bottom: var(--space-16);
  }
  .skills-grid__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
  }
  .skills-grid__chip {
    padding: var(--space-3) var(--space-10);
    border-radius: var(--radius-pill);
    background: var(--color-surface-2);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
  }
</style>
