# Portfolio - Variables de categoria SERVER.
#
# Config del backend serverless (Lambdas: contact_form, tracking_pixel,
# stream_processor, db). Incluye SECRETOS de runtime.
#
# Fuente de verdad del inventario:
#   serverless/lambda/resources/secrets/*.yaml (catalogo declarativo)
# devtools (en `serverless deploy --stage=<env>`) lee este .env y publica
# cada secreto a SSM Parameter Store. Las Lambdas leen SSM en runtime.
#
# Copiar a docker/env/server/.{local,dev,stage,test,prod}.
# Los archivos .{env} estan en .gitignore; este .example si se versiona.

# === Catalogo: serverless/lambda/resources/secrets/ ========================
# Cada entrada de abajo corresponde a un archivo YAML del catalogo.

# --- turnstile-secret.yaml (SecureString) ---
# Cloudflare Turnstile secret key (siteverify)
# SSM: /portfolio/${stage}/turnstile-secret
TURNSTILE_SECRET_KEY=

# --- turnstile-bypass-public-key.yaml (String, dev/stage) ---
# Clave PUBLICA Ed25519 que verifica el bypass token de los tests E2E.
# NO es secreta. La genera `bypass_token keygen` (la PRIVADA va a dev-cli,
# nunca aca). SSM: /portfolio/${stage}/turnstile-bypass-public-key
TURNSTILE_BYPASS_PUBLIC_KEY=

# --- neon-url.yaml (SecureString) ---
# Neon PostgreSQL connection string completa (pooled, sslmode=require)
# SSM: /portfolio/${stage}/neon-url
DB_URL=

# --- owner-email.yaml (String, global compartido) ---
# Email destino del form de contacto.
# SSM: /portfolio/owner-email
OWNER_EMAIL=

# --- ses-from-address.yaml (String, global compartido) ---
# Direccion remitente verificada en SES (domain the-full-stack.com).
# SSM: /portfolio/ses-from-address
EMAIL_FROM=

# --- ses-from-name.yaml (String, global compartido, opcional) ---
# Display name del remitente en emails SES.
# SSM: /portfolio/ses-from-name
EMAIL_FROM_NAME=

# --- admin-emails.yaml (SecureString) ---
# Lista coma-separada de emails admin (whitelist del scope admin.* del
# Lambda users). Rotar admins = editar este valor + sync_secrets.
# SSM: /portfolio/${stage}/admin-emails
ADMIN_EMAILS=

# === Variables NO catalogadas (inline en manifest.yaml de cada Lambda) =====

# --- AWS endpoints (override para local-dev con dynamodb-local) ---
# Solo en .local y .test: apunta boto3 al container amazon/dynamodb-local
# del compose. boto3 1.28+ respeta AWS_ENDPOINT_URL_<SERVICE> nativamente.
# En .dev/.stage/.prod debe quedar vacio para usar el endpoint AWS real.
#   .local -> http://localhost:8000
#   .test  -> http://localhost:8001
AWS_ENDPOINT_URL_DYNAMODB=

# --- Email backend (decision de runtime) ---
# `ses` (cloud) | `console` (dev, imprime a stdout).
EMAIL_BACKEND=

# --- AWS region / recursos (constantes derivables) ---
AWS_REGION=us-east-1
AWS_SES_REGION=us-east-1
AWS_S3_REGION_NAME=us-east-1
AWS_STORAGE_BUCKET_NAME=

# --- AWS SSM Parameter Store (prefijo y KMS key) ---
SSM_PATH_PREFIX=/portfolio
KMS_KEY_ALIAS=alias/portfolio-lambdas

# --- Database Neon: campos NO sensibles (informativos, embebidos en DB_URL) ---
DB_DB=neondb
DB_USER=neondb_owner
DB_PORT=5432
DB_SSLMODE=require
DB_CHANNEL_BINDING=require
# DB_HOST identifica el branch/proyecto Neon (no es secreto pero varia por stage).
DB_HOST=
# DB_PASSWORD esta embebida en DB_URL; declararla aparte es opcional.
DB_PASSWORD=

# --- jwt-secret.yaml (SecureString) ---
# HS256 secret del dominio auth (firma/verifica temp/access/refresh).
# Generar: python -c "import secrets; print(secrets.token_urlsafe(64))"
# SSM: /portfolio/${stage}/jwt-secret
JWT_SECRET=
