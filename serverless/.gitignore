# Artefacto de deploy que devtools arma con uv (efimero, por lambda).
lambda/services/*/build/
lambda/services/*/build.zip
lambda/services/*/core/shared/
lambda/services/*/.invoke/

# Estado local del backend (efimero, regenerable, por entorno).
lambda/.state/*.json

# requirements.txt efimero (la fuente de verdad es pyproject.toml + uv.lock).
lambda/services/*/requirements.txt
lambda/services/*/requirements-dev.txt

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# uv
.uv-cache/

# Lambda zips locales
*.zip

# Env files
env/.env.dev
env/.env.prod
env/.env.local

# Outputs de deploy (committeados como referencia post-deploy)
# Se regeneran con: python devtools/run.py serverless outputs --stage={dev,prod}

# tmp local del developer
tmp/
