{
  "name": "@portfolio/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Design system + Astro components + animations for the portfolio monorepo",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./components/*.astro": "./src/components/*.astro",
    "./layouts/*.astro": "./src/layouts/*.astro",
    "./styles/*.css": "./src/styles/*.css",
    "./lib/*": "./src/lib/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
    "@fontsource-variable/space-grotesk": "^5.2.5",
    "@fontsource/space-grotesk": "^5.1.1",
    "@fontsource/space-mono": "^5.1.1",
    "@portfolio/content": "workspace:*"
  },
  "peerDependencies": {
    "astro": "^5.0.0"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^15.11.7",
    "typescript": "^5.9.3",
    "vite": "^8.0.12",
    "vitest": "^2.1.9"
  }
}
