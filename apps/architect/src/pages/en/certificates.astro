---
import CertificatesSection from '@portfolio/app-shared/pages/CertificatesSection.astro'
import PageLayout from '../../layouts/PageLayout.astro'
import { NICHE, STRINGS } from '../../lib/site-config'

const t = STRINGS.en
---

<PageLayout
  title={`${t.pages.certificates.titlePrefix} — ${t.meta.title}`}
  description={t.pages.certificates.description}
  canonicalPath="/en/certificates"
  locale="en"
  otherLocalePath="/certificates"
>
  <CertificatesSection niche={NICHE} locale="en" strings={t} />
</PageLayout>
