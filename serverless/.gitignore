# SAM build artifacts
.aws-sam/
samconfig.toml.local

# Artefacto de deploy que devtools arma con uv (efimero, por lambda).
src/*/build/
src/*/template.yaml
src/*/core/shared/

# requirements.txt efimero (la fuente de verdad es pyproject.toml + uv.lock).
src/*/requirements.txt
src/*/requirements-dev.txt

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# uv
.uv-cache/

# Lambda zips locales
*.zip

# Env files
env/.env.dev
env/.env.prod
env/.env.local

# Outputs de deploy (committeados como referencia post-deploy)
# Se regeneran con: python devtools/run.py serverless outputs --stage={dev,prod}

# tmp local del developer
tmp/
