{
  "name": "@portfolio/journey",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Journey 3D CV — el CV como viaje 3D por habitaciones (Propuesta A)",
  "scripts": {
    "dev": "astro dev --port 4327",
    "build": "astro build",
    "preview": "astro preview --port 4327",
    "astro": "astro",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prebuild": "pnpm --filter @portfolio/content run fetch-cache && vite-node --config scripts/vite.config.ts scripts/build-public-assets.mjs",
    "predev": "pnpm --filter @portfolio/content run fetch-cache",
    "postbuild": "vite-node --config scripts/vite.config.ts scripts/postbuild-markdown.mjs && vite-node --config scripts/vite.config.ts scripts/postbuild-functions.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.4.2",
    "@astrojs/sitemap": "^3.7.2",
    "@portfolio/app-shared": "workspace:*",
    "@portfolio/content": "workspace:*",
    "@portfolio/markdown-export": "workspace:*",
    "@portfolio/mcp": "workspace:*",
    "@portfolio/seo": "workspace:*",
    "@portfolio/ui": "workspace:*",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@tailwindcss/vite": "^4.0.18",
    "astro": "^6.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.0.18",
    "three": "^0.170.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitest/coverage-v8": "^2.1.9",
    "happy-dom": "^15.11.7",
    "js-yaml": "^4.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9"
  }
}
