{
  "name": "@portfolio/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Source of truth for Pablo Contreras CV data + Zod schemas + niche filters",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./data/*": "./src/data/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@modyfi/vite-plugin-yaml": "^1.1.1",
    "@types/js-yaml": "^4.0.9",
    "@vitest/coverage-v8": "^2.1.9",
    "js-yaml": "^4.1.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^2.1.9"
  }
}
