---
/**
 * @page contact (es) vibe
 */
import { profile } from '@portfolio/content'
import ContactForm from '@portfolio/ui/components/ContactFormReact.astro'
import ContactLinks from '@portfolio/ui/components/ContactLinks.astro'
import PageLayout from '../layouts/PageLayout.astro'
import { NICHE, STRINGS } from '../lib/site-config'

const t = STRINGS.es
const cp = t.components.contactPage

// API endpoint y Turnstile sitekey desde env vars (publicas, ok exponer)
const apiEndpoint = (import.meta.env.PUBLIC_API_ENDPOINT || '') as string
const turnstileSitekey = (import.meta.env.PUBLIC_TURNSTILE_SITEKEY ||
  '') as string
const contactEndpoint = apiEndpoint ? `${apiEndpoint}/contact` : ''
const fallbackParts = cp.fallback.split('{email}')
---

<PageLayout
  title={`${t.pages.contact.titlePrefix} — ${t.meta.title}`}
  description={t.pages.contact.description}
  canonicalPath="/contact"
  locale="es"
  otherLocalePath="/en/contact"
>
  <section class="contact-section">
    <header class="contact-header">
      <h1>{cp.heading}</h1>
      <p>{cp.intro}</p>
    </header>

    {
      contactEndpoint && turnstileSitekey ? (
        <ContactForm
          apiEndpoint={contactEndpoint}
          turnstileSitekey={turnstileSitekey}
          niche={NICHE}
          strings={t.components.contactForm}
        />
      ) : (
        <div class="contact-fallback">
          <p>
            {fallbackParts[0]}
            <a href={`mailto:${profile.contacts.email}`}>
              {profile.contacts.email}
            </a>
            {fallbackParts[1]}
          </p>
        </div>
      )
    }

    <div class="contact-direct">
      <h2 class="contact-direct__title">{cp.otherChannels}</h2>
      <ContactLinks
        email={profile.contacts.email}
        linkedin={profile.contacts.linkedin}
        github={profile.contacts.github}
        strings={t.components.contactLinks}
      />
    </div>
  </section>
</PageLayout>

<style>
  .contact-section {
    max-width: var(--container-medium);
    margin: var(--space-56) auto;
    padding-inline: var(--space-24);
  }

  .contact-header {
    margin-bottom: var(--space-40);
    text-align: center;
  }

  .contact-header h1 {
    font-size: var(--font-size-32);
    font-weight: 700;
    margin-bottom: var(--space-12);
  }

  .contact-header p {
    color: var(--color-text-muted);
    font-size: var(--font-size-14);
  }

  .contact-fallback {
    text-align: center;
    padding: var(--space-32);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  .contact-fallback a {
    color: var(--color-primary-text);
  }

  .contact-direct {
    margin-top: var(--space-40);
    padding-top: var(--space-32);
    border-top: 1px solid var(--color-border);
  }

  .contact-direct__title {
    font-size: var(--font-size-20);
    font-weight: 600;
    margin-bottom: var(--space-16);
    text-align: center;
  }
</style>
