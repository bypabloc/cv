---
import CvSections from '@portfolio/app-shared/components/CvSections.astro'
import { SITE_URLS } from '@portfolio/app-shared/lib/site-urls'
import Journey3D from '../components/Journey3D'
/**
 * @page index (es) journey
 * @description La experiencia 3D (Propuesta A, habitaciones) con el CV 2D
 *   como fallback SIEMPRE presente en el HTML (tier Static + SEO/ATS).
 *   La isla 3D se monta encima solo en tiers Full/Reduced.
 */
import PageLayout from '../layouts/PageLayout.astro'
import { NICHE, STRINGS } from '../lib/site-config'

const t = STRINGS.es
const title = 'Pablo Contreras — CV como viaje 3D'
const description =
  'Recorre la carrera de Pablo Contreras como un viaje 3D: una habitacion ' +
  'por experiencia, de la universidad a la arquitectura fintech.'
const cvHref = `${SITE_URLS.generic}/cv.html`
---

<PageLayout
  title={title}
  description={description}
  canonicalPath="/"
  locale="es"
  otherLocalePath="/en/"
>
  <!-- fallback SEO/ATS: el CV completo vive en el HTML sin ejecutar JS -->
  <div id="cv-fallback">
    <CvSections niche={NICHE} locale="es" strings={t} cvHref={cvHref} />
  </div>
  <!-- isla 3D: solo monta en tiers Full/Reduced (client:only, AC-1/AC-2) -->
  <Journey3D client:only="react" locale="es" />
</PageLayout>
