---
/**
 * @layout SitePageLayout
 * @description Wrapper compartido. Cada app pasa siteUrl + niche + strings.
 *   Inyecta tokens visuales del nicho (--niche-accent, --niche-glow, ...)
 *   en el <main> y bootstrappea magnetic-cursor + number-counters.
 *
 * @props {string} title - title HTML
 * @props {string} description - meta description
 * @props {string} canonicalPath - path relativo (/about, /, /en/about, etc.)
 * @props {string} otherLocalePath - path equivalente en el otro idioma
 * @props {'es'|'en'} locale
 * @props {string} siteUrl - base canonical del sitio
 * @props {import('@portfolio/content').Niche} niche
 * @props {object} strings - I18nStrings de la app (nav, components, ...)
 * @props {string} [ogImage]
 */
import type { I18nStrings } from '@portfolio/app-shared'
import type { Niche } from '@portfolio/content'
import { filterByNiche, profile, skills } from '@portfolio/content'
import {
  buildProfilePageSchema,
  buildSiteNavigationSchema,
} from '@portfolio/seo'
import { nicheTokensToCssVars } from '@portfolio/ui'
import Footer from '@portfolio/ui/components/Footer.astro'
import Nav from '@portfolio/ui/components/Nav.astro'
import TrackingPixel from '@portfolio/ui/components/TrackingPixel.astro'
import BaseLayout from '@portfolio/ui/layouts/BaseLayout.astro'

interface Props {
  title: string
  description: string
  canonicalPath: string
  otherLocalePath: string
  locale: 'es' | 'en'
  siteUrl: string
  niche: Niche
  strings: I18nStrings
  ogImage?: string
}

const {
  title,
  description,
  canonicalPath,
  otherLocalePath,
  locale,
  siteUrl,
  niche,
  strings,
  ogImage,
} = Astro.props

const navItems = strings.nav

const canonicalUrl = `${siteUrl}${canonicalPath}`
const knowsAbout = filterByNiche(skills, niche).flatMap((c) =>
  c.skills.slice(0, 5),
)
const profilePageLd = buildProfilePageSchema({
  profile,
  niche,
  locale,
  canonicalUrl,
  knowsAbout,
})

// SiteNavigationElement: declara las paginas principales del sitio para que
// Google entienda la jerarquia (favorece sitelinks en busquedas de marca).
// Los nombres salen del YAML i18n; el path se deriva del locale.
const prefix = locale === 'es' ? '' : '/en'
const navSchemaItems = [
  { name: strings.labels.home, path: `${prefix}/` },
  { name: strings.sections.about.title, path: `${prefix}/about` },
  {
    name: strings.sections.certificates.title,
    path: `${prefix}/certificates`,
  },
  { name: strings.sections.contact.title, path: `${prefix}/contact` },
]
const siteNavigationLd = buildSiteNavigationSchema({
  siteUrl,
  items: navSchemaItems,
})

const jsonLd = [profilePageLd, siteNavigationLd]

// hreflang: par es <-> en de la pagina actual, URLs absolutas.
const alternates = [
  {
    hreflang: 'es',
    href: `${siteUrl}${locale === 'es' ? canonicalPath : otherLocalePath}`,
  },
  {
    hreflang: 'en',
    href: `${siteUrl}${locale === 'en' ? canonicalPath : otherLocalePath}`,
  },
]

const nicheStyle = nicheTokensToCssVars(niche)
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  locale={locale}
  ogImage={ogImage}
  jsonLd={jsonLd}
  alternates={alternates}
  skipToContentLabel={strings.components.layout.skipToContent}
>
  <Nav
    slot="nav"
    brand={profile.name}
    brandHref={locale === 'es' ? '/' : '/en/'}
    items={navItems}
    currentLocale={locale}
    otherLocaleHref={otherLocalePath}
    strings={strings.components.nav}
    themeStrings={strings.components.themeToggle}
  />
  <div class="niche-root" data-niche={niche} style={nicheStyle}>
    <slot />
  </div>
  <Footer
    slot="footer"
    name={profile.name}
    contacts={profile.contacts}
    strings={strings.components.footer}
  />
  <TrackingPixel
    apiEndpoint={import.meta.env.PUBLIC_API_ENDPOINT}
    niche={niche}
  />
  <script>
    import {
      initMagneticCursor,
      initMobileNav,
      initNumberCounters,
    } from '@portfolio/ui'

    let magneticCleanup: (() => void) | undefined
    let counterCleanup: (() => void) | undefined
    let mobileNavCleanup: (() => void) | undefined

    const boot = () => {
      magneticCleanup?.()
      counterCleanup?.()
      mobileNavCleanup?.()
      magneticCleanup = initMagneticCursor()
      counterCleanup = initNumberCounters()
      mobileNavCleanup = initMobileNav()
    }

    boot()
    document.addEventListener('astro:after-swap', boot)
  </script>
</BaseLayout>

<style is:global>
  .niche-root {
    display: contents;
  }
</style>
